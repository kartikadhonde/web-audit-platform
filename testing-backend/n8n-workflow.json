      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "command": "mkdir -p /tmp/web-audit-platform && cd /tmp/web-audit-platform && if [ ! -d \".git\" ]; then git clone https://github.com/YOUR_USERNAME/web-audit-platform.git .; else git fetch origin && git reset --hard origin/main; fi"
      },
      "id": "5f606da0-d29b-4f9e-99cb-db8b8a5d3f21",
      "name": "Clone/Pull Code",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [620, 300]
    },
    {
      "parameters": {
        "command": "cd /tmp/web-audit-platform && npm install --package-lock-only && npm audit --json",
        "options": {
          "alwaysOutputResult": true
        }
      },
      "id": "4b68e001-c852-4fc8-9f15-bc758369165d",
      "name": "Dependency Audit",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [840, 300]
    },
    {
      "parameters": {
        "command": "cd /tmp/web-audit-platform && npm install eslint --no-save && npx eslint . --format json",
        "options": {
          "alwaysOutputResult": true
        }
      },
      "id": "3c847e11-e123-4abc-999d-ed8731234bef",
      "name": "Complexity Scan",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1060, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "value1": "={{ JSON.parse($node[\"Dependency Audit\"].json.stdout).metadata.vulnerabilities.critical || 0 }}",
              "operation": "larger",
              "value2": 0,
              "fallbackOutput": 1
            },
            {
              "value1": "={{ (JSON.parse($node[\"Complexity Scan\"].json.stdout)[0] && JSON.parse($node[\"Complexity Scan\"].json.stdout).reduce((acc, current) => acc + current.errorCount, 0)) || 0 }}",
              "operation": "larger",
              "value2": 0,
              "fallbackOutput": 2
            }
          ]
        },
        "fallbackOutput": 3
      },
